# Copie para .env (nesta pasta ops/) e troque TODOS os valores. Nunca versione o .env.
# Usado por: docker compose -p dom-satelites -f docker-compose.satelites.yml up -d
# Gere chaves com: openssl rand -hex 24

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_KEY=troque-por-uma-chave-longa-aleatoria
EVOLUTION_DB_PASSWORD=troque-por-outra-senha-longa
EVOLUTION_INSTANCE=dom-cristo

# --- n8n ---
# IP/host por onde voce abre o n8n no navegador (WSL: localhost)
N8N_HOST=192.168.0.10
N8N_ENCRYPTION_KEY=troque-por-uma-chave-aleatoria-de-32-chars

# O Frappe/MariaDB NAO le este arquivo: as variaveis dele ficam no .env do frappe_docker
# (RUNBOOK, Etapa D).
